PORT=5000
JWT_SECRET=your_secure_jwt_secret_key_2026

# ---------------------------------------------------------
# DATABASE CONFIGURATION (TiDB Cloud Serverless / MySQL)
# ---------------------------------------------------------
DATABASE_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DATABASE_PORT=4000
DATABASE_USER=your_tidb_username.root
DATABASE_PASSWORD=your_tidb_password
